[
  {
    "name": "01_write_essbase_basic",
    "description": "Write two rows to Essbase Sample/Basic via config_rows",
    "config": {
      "action": "run",
      "parameters": {
        "username": "admin",
        "#password": "DUMMY_PASSWORD",
        "essbase_host": "34.31.58.133",
        "essbase_port": 9010,
        "ssl_verify": false,
        "use_ssl": false
      },
      "config_rows": [
        {
          "id": "write-sample-basic",
          "is_disabled": false,
          "parameters": {
            "source": {
              "input_table": "essbase_sample_basic",
              "batch_size": 1000,
              "context_members": [
                "East",
                "Actual",
                "Sales"
              ]
            },
            "destination": {
              "application": "Sample",
              "database": "Basic"
            }
          }
        }
      ],
      "storage": {
        "input": {
          "tables": [
            {
              "source": "essbase_sample_basic.csv",
              "destination": "essbase_sample_basic.csv"
            }
          ]
        }
      }
    }
  },
