  {
    "name": "09_write_essbase_full_mapping",
    "description": "column_mapping covers all 4 CSV columns and renames the period columns to valid later-period Essbase members — verifies rename logic end-to-end",
    "config": {
      "action": "run",
      "parameters": {
        "connection": {
          "essbase_host": "34.31.58.133",
          "essbase_port": 9010,
          "username": "admin",
          "#password": "DUMMY_PASSWORD",
          "ssl_verify": false,
          "use_ssl": false
        },
        "source": {
          "input_table": "essbase_four_cols",
          "batch_size": 1000,
          "context_members": ["East", "Actual", "Sales"],
          "column_mapping": [
            {"source": "Product", "destination": "Product"},
            {"source": "Jan", "destination": "Feb"},
            {"source": "Feb", "destination": "Mar"},
            {"source": "Mar", "destination": "Apr"}
          ]
        },
        "destination": {
          "application": "Sample",
          "database": "Basic"
        }
      },
      "storage": {
        "input": {
          "tables": [
            {"source": "essbase_four_cols.csv", "destination": "essbase_four_cols.csv"}
          ]
        }
      }
    }
