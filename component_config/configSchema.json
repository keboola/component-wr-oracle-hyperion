{
  "type": "object",
  "title": "Oracle Essbase — Connection Settings",
  "required": ["essbase_host", "username", "#password"],
  "properties": {
    "essbase_host": {
      "type": "string",
      "title": "Essbase Host",
      "description": "Essbase server hostname or IP address (e.g. essbase.example.com or 10.0.0.4)",
      "propertyOrder": 1
    },
    "essbase_port": {
      "type": "integer",
      "title": "Essbase REST API Port",
      "description": "Port for Essbase 21C REST API (default: 9010)",
      "default": 9010,
      "propertyOrder": 2
    },
    "username": {
      "type": "string",
      "title": "Username",
      "propertyOrder": 3
    },
    "#password": {
      "type": "string",
      "title": "Password",
      "format": "password",
      "propertyOrder": 4
    },
    "use_ssl": {
      "type": "boolean",
      "title": "Use SSL",
      "description": "Connect to Essbase over HTTPS (recommended). Disable only for plain HTTP environments.",
      "format": "checkbox",
      "default": true,
      "propertyOrder": 5
    },
    "ssl_verify": {
      "type": "boolean",
      "title": "Verify SSL Certificate",
      "description": "Validate the server's SSL certificate. Disable only when using self-signed certificates.",
      "format": "checkbox",
      "default": true,
      "propertyOrder": 6
    },
    "debug": {
      "type": "boolean",
      "title": "Debug Mode",
      "format": "checkbox",
      "default": false,
      "propertyOrder": 7
    },
    "test_connection": {
      "type": "button",
      "format": "test-connection",
      "propertyOrder": 8,
      "options": {
        "async": {
          "label": "Test Connection",
          "action": "testConnection"
        }
      }
    }
  }
}
