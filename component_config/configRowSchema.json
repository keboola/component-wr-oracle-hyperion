{
  "type": "object",
  "title": "Write Configuration",
  "properties": {
    "_metadata_": {
      "type": "object",
      "options": {
        "hidden": true
      },
      "properties": {
        "table": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "columns": {
              "type": "array"
            },
            "primaryKey": {
              "type": "array"
            }
          }
        }
      }
    },
    "destination": {
      "type": "object",
      "title": "Destination",
      "format": "collapse",
      "propertyOrder": 1,
      "properties": {
        "application": {
          "type": "string",
          "title": "Application",
          "description": "Essbase application name",
          "format": "select",
          "enum": [],
          "required": true,
          "propertyOrder": 1,
          "options": {
            "async": {
              "label": "Load Applications",
              "action": "listApplications",
              "autoload": true
            }
          }
        },
        "database": {
          "type": "string",
          "title": "Database / Cube",
          "description": "Essbase database (cube) name",
          "format": "select",
          "enum": [],
          "required": true,
          "propertyOrder": 2,
          "options": {
            "async": {
              "label": "Load Databases",
              "action": "listDatabases"
            },
            "dependencies": {
              "destination.application": true
            }
          }
        }
      }
    },
    "source": {
      "type": "object",
      "title": "Source",
      "format": "collapse",
      "propertyOrder": 2,
      "properties": {
        "column_mapping": {
          "title": "Column Mapping",
          "description": "Maps input table columns to Essbase member/dimension names. Only mapped columns are written. Leave empty to pass all columns through unchanged.",
          "type": "array",
          "format": "table",
          "propertyOrder": 1,
          "default": [],
          "items": {
            "type": "object",
            "required": ["source", "destination"],
            "title": "Column",
            "properties": {
              "source": {
                "type": "string",
                "title": "Source Column",
                "watch": {
                  "columns": "_metadata_.table.columns"
                },
                "enumSource": "columns",
                "propertyOrder": 1,
                "options": {
                  "creatable": true
                }
              },
              "destination": {
                "type": "string",
                "title": "Essbase Member / Dimension Name",
                "propertyOrder": 2
              }
            }
          }
        },
        "reload_columns": {
          "type": "button",
          "format": "sync-action",
          "propertyOrder": 2,
          "options": {
            "async": {
              "label": "Reload Columns",
              "action": "listColumns"
            }
          }
        },
        "batch_size": {
          "type": "integer",
          "title": "Batch Size",
          "description": "Number of rows to send per API call.",
          "default": 1000,
          "minimum": 1,
          "propertyOrder": 3
        }
      }
    }
  }
}
